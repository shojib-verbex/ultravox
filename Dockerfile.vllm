# Dockerfile for Qwen3-Omni vLLM Server
# Based on official qwenllm/qwen3-omni:3-cu124 build process
# This provides fast inference for Qwen3-Omni models using vLLM
#
# Build:
#   docker compose --profile vllm-server build vllm-server
#
# Run:
#   docker compose --profile vllm-server up -d vllm-server
#   docker compose --profile eval-qwen3-vllm up eval-qwen3-vllm

ARG CUDA_VERSION=12.4.0
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/cache/huggingface
ENV MAX_JOBS=32
ENV NVCC_THREADS=2

# Install system dependencies
RUN apt-get update -y && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    git \
    git-lfs \
    python3 \
    python3-pip \
    python3-dev \
    wget \
    vim \
    curl \
    libsndfile1 \
    ccache \
    software-properties-common \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install CMake (required for building vLLM from source)
RUN wget https://github.com/Kitware/CMake/releases/download/v3.26.1/cmake-3.26.1-Linux-x86_64.sh \
    -q -O /tmp/cmake-install.sh \
    && chmod u+x /tmp/cmake-install.sh \
    && mkdir /opt/cmake-3.26.1 \
    && /tmp/cmake-install.sh --skip-license --prefix=/opt/cmake-3.26.1 \
    && rm /tmp/cmake-install.sh \
    && ln -s /opt/cmake-3.26.1/bin/* /usr/local/bin

RUN ln -s /usr/bin/python3 /usr/bin/python

RUN git lfs install

WORKDIR /build

# Install vLLM from Qwen3-Omni fork (has proper multimodal support)
RUN pip3 install --upgrade pip setuptools wheel && \
    git clone -b qwen3_omni https://github.com/wangxiongts/vllm.git /build/vllm && \
    cd /build/vllm && \
    pip3 install -r requirements/build.txt && \
    pip3 install -r requirements/cuda.txt && \
    pip3 install . -v --no-build-isolation && \
    rm -rf /build/vllm

# Install specific transformers version for compatibility
RUN pip3 install transformers==4.57.3

# Install Flash Attention for faster inference
RUN pip3 install flash-attn --no-build-isolation

# Install additional dependencies
RUN pip3 install \
    networkx==3.4.2 \
    accelerate==1.10.1 \
    qwen-omni-utils \
    "huggingface_hub[cli]>=0.34.0,<1.0" \
    soundfile==0.13.1 \
    librosa

# Clean up pip cache
RUN rm -rf /root/.cache/pip

# Create cache directory
RUN mkdir -p /cache/huggingface

WORKDIR /app

# Expose vLLM server port
EXPOSE 7000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
    CMD curl -f http://localhost:7000/health || exit 1

# Default command: start vLLM server with Qwen3-Omni
# CUDA graphs enabled for better GPU utilization
# Can be overridden via docker-compose or command line
CMD ["python", "-m", "vllm.entrypoints.openai.api_server", \
     "--model", "Qwen/Qwen3-Omni-30B-A3B-Instruct", \
     "--port", "7000", \
     "--dtype", "bfloat16", \
     "--tensor-parallel-size", "2", \
     "--trust-remote-code", \
     "--gpu-memory-utilization", "0.85"]
