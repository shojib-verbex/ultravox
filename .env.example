# HuggingFace token (required for some gated models)
HF_TOKEN=your_huggingface_token_here

# HuggingFace cache directory (optional, defaults to ~/.cache/huggingface)
HF_CACHE_DIR=~/.cache/huggingface

# Weights & Biases API key (optional, for logging)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=ultravox

# CUDA devices to use (optional, defaults to all)
CUDA_VISIBLE_DEVICES=0

# Evaluation config file (for eval service)
EVAL_CONFIG=ultravox/evaluation/configs/eval_config_air_bench.yaml
